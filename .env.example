# Copy this file to .env and fill in real values. Never commit .env.
#
# Data provider selection. Currently supported: "yfinance"
DATA_PROVIDER=yfinance

# Root directory for all local data artifacts (parquet files, DuckDB file, logs).
# Relative paths are resolved against the project root.
DATA_DIR=data_files

# DuckDB database file path (relative to DATA_DIR unless absolute).
DUCKDB_PATH=duckdb/quant_platform.duckdb

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Networking / rate limiting for data providers
HTTP_MAX_RETRIES=5
HTTP_BACKOFF_BASE_SECONDS=1.5
HTTP_REQUEST_TIMEOUT_SECONDS=30
HTTP_MIN_INTERVAL_SECONDS=0.6

# Placeholder for a future paid data provider API key (not required for yfinance)
# MARKET_DATA_API_KEY=

# Optional third live-quote source for paper trading (data/providers/twelve_data.py).
# Free tier signup: https://twelvedata.com/pricing (800 requests/day, no card required).
# Leave unset to use only NSE India + yfinance - both work with zero configuration.
# TWELVE_DATA_API_KEY=
